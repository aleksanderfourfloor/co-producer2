# OpenAI API Key for the AI co-producer brain
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI model to use (default: gpt-4o)
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, etc.
OPENAI_MODEL=gpt-4o

# OpenAI fast/cheap model to use for simple tasks (default: gpt-4o-mini)
OPENAI_MODEL_FAST=gpt-4o-mini

# Server port (default: 3001)
PORT=3001

# Ollama local model config (used as the free primary tier)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
